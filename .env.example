DATABASE_URL=sqlite:///./app.db
# Production: postgresql://user:password@host:5432/dbname

# --- Auth and integrations (copy to .env for local use; never commit real values) ---
APP_ENV=dev                     # dev | staging | production (production refuses dev secrets and fake integrations)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ADMIN_API_KEY=                  # empty disables /admin/*; set to a long random string to create partners
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me-0123456789
OTP_SENDER=console              # console | (sms adapter to be implemented)
PAYMENT_GATEWAY=fake            # fake | (gateway adapter to be implemented)
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=5
LOG_LEVEL=INFO
